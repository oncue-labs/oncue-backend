# Copy this file to .env.local for local development or .env.production for deployment.
# Never commit either copied file. Never put real secrets in this template.

DB_URL=jdbc:mysql://localhost:3306/oncue?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=oncue
DB_PASSWORD=replace-with-environment-specific-password
DB_DRIVER=com.mysql.cj.jdbc.Driver
REDIS_HOST=localhost
REDIS_PORT=6379

JWT_SIGNING_SECRET=replace-with-environment-specific-secret
ACCESS_TOKEN_TTL=PT1H
REFRESH_TOKEN_TTL=720h

ONCUE_AUTH_X_CLIENT_ID=replace-with-x-client-id
ONCUE_AUTH_X_CLIENT_SECRET=replace-with-x-client-secret
X_REDIRECT_URI=com.oncue.oncuemobile://oauth/x/callback

VOICE_SERVER_URL=http://localhost:8000
VOICE_INTERNAL_SERVICE_TOKEN=replace-with-environment-specific-service-token
VOICE_JWT_PRIVATE_KEY=
VOICE_JWT_PRIVATE_KEY_FILE=

APNS_KEY_ID=replace-with-apns-key-id
APNS_TEAM_ID=replace-with-apple-team-id
APNS_BUNDLE_ID=com.oncue.oncueMobile
APNS_PRIVATE_KEY=
APNS_PRIVATE_KEY_FILE=
